# Default server configuration
#

server {
    listen 443 ssl;
    server_name cefire.eu;

    ssl_certificate     /root/ssl/fullchain.crt;
    ssl_certificate_key /root/ssl/privkey.key;

        # Add index.php to the list if you are using PHP
        index index.html index.htm index.nginx-debian.html;

#        server_name _;

#    location / {
         # First attempt to serve request as file, then
         # as directory, then fall back to displaying a 404.
#         try_files $uri $uri/ =404;
#    }
#

    location / {
        proxy_pass http://unix:/var/www/html/myapp/myflask.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploads Excel grandes
    client_max_body_size 50M;

    # Logs
    access_log /var/log/nginx/cefire_access.log;
    error_log /var/log/nginx/cefire_error.log;

}